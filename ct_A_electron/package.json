{
  "name": "ct-achats-desktop",
  "version": "1.0.0",
  "description": "CT_Achats - Application Desktop de Gestion des Achats",
  "main": "dist/main/index.js",
  "author": "Congo Telecom",
  "license": "proprietary",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukatu/ct_achats.git"
  },
  "scripts": {
    "dev": "npm run build:main && electron .",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "cd ../ct_A_frontend && npx vite build",
    "build": "npm run build:main && npm run build:renderer",
    "pack": "electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "npm run build && electron-builder --win --mac",
    "postinstall": "electron-builder install-app-deps",
    "download-php": "node scripts/download-php.js"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "adm-zip": "^0.5.16",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "sharp": "^0.34.5",
    "typescript": "^5.3.3"
  }
}
